{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Camera to hormone and CPG (no ROS)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_face_lamp.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Replay without camera or ROS",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_face_lamp.py",
      "args": ["--replay", "examples/observations.jsonl", "--plot"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
